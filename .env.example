# GymSynk Environment Configuration
# Copy this file to .env and fill in your values.
# setup-cli.sh handles this automatically for new deployments.
#
#  pnpm -- filter web exec
# IMPORTANT: Never commit .env to version control.
NEXT_PUBLIC_API_URL=
# =============================================================================
# REQUIRED - Domain & TLS
# =============================================================================

# Your gym's domain (DNS A record must point to this VPS)
DOMAIN=gym.yourgym.com

# Email for Let's Encrypt TLS certificate registration
ACME_EMAIL=admin@yourgym.com

# =============================================================================
# REQUIRED - Secrets (auto-generated by setup-cli.sh)
# =============================================================================

# PostgreSQL password - use a strong random value (32+ chars)
POSTGRES_PASSWORD=

# Redis auth password - use a strong random value
REDIS_PASSWORD=

# JWT signing secret - must be a 32-byte hex string (64 hex chars)
# Generate: openssl rand -hex 32
JWT_SECRET=

# =============================================================================
# REQUIRED - Payment Mode
# =============================================================================

# Choose one: CASH_ONLY | TRACK_AND_RECEIPT | FULL_PROCESSING
# CASH_ONLY       - Log payments manually, no receipts, no gateway
# TRACK_AND_RECEIPT - Log payments + generate PDF receipt on-demand, email to member
# FULL_PROCESSING  - Payment gateway (Paystack or Flutterwave or LemonSqueezy) required
PAYMENT_MODE=CASH_ONLY

# =============================================================================
# CONDITIONAL - Payment Gateway (required only if PAYMENT_MODE=FULL_PROCESSING)
# =============================================================================

# Provide one of the following (not both)

# Paystack secret key (https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=

# LemonSqueezy secret key (https://app.lemonsqueezy.com/dashboard)
LEMONSQUEEZY_SECRET_KEY=


# =============================================================================
# REQUIRED FOR EMAIL - Resend (OTP delivery and expiry warnings)
#
# Verify the sending domain in Resend first. The address itself does not need
# to exist as a mailbox; for example, noreply@mockline.dev is valid after
# mockline.dev is verified.
# =============================================================================

# Create a Sending access key in Resend and do not commit its value.
RESEND_API_KEY=

# From address for all outgoing emails. Must use the verified Resend domain.
RESEND_FROM=GymSynk <noreply@yourdomain.com>

# =============================================================================
# AUTO-SET BY DOCKER COMPOSE - Do not override
# =============================================================================

# Spring profile (set to 'prod' by docker-compose.yml)
# SPRING_PROFILES_ACTIVE=prod

# =============================================================================
# NOTES
# =============================================================================
#
# No file storage variables (STORAGE_PATH, MINIO_*, etc.) are needed.
# GymSynk has no file storage layer:
#   - Member and gym avatars are auto-generated by DiceBear (client-side, initials-based)
#   - PDF receipts are generated in-memory on-demand and streamed — never stored on disk
#
# No SMS variables (SMS_PROVIDER, SMS_API_KEY) are needed in v1.
# OTP codes are delivered by email only. SMS support is planned for v1.5.
